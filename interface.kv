#:kivy 2.2.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import cor kivy.utils.get_color_from_hex

#:set FUNDO cor('#141414')
#:set CARTAO cor('#1C1C1E')
#:set BORDA cor('#2E2E31')
#:set CARTAO2 cor('#2C2C2E')
#:set TEXTO cor('#F2F2F2')
#:set TEXTO2 cor('#A1A1A6')
#:set AMBAR cor('#F5B83D')
#:set AZUL cor('#1A6BFF')
#:set CINZA_CLARO cor('#D6D6D9')
#:set VERMELHO cor('#FF6B61')
#:set VERMELHO_FORTE cor('#B42318')
#:set ESCURO cor('#121417')

<Texto@Label>:
    color: TEXTO
    font_size: sp(16) * app.escala_texto
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1]
    halign: 'left'
    valign: 'middle'

<Titulo@Texto>:
    font_size: sp(24) * app.escala_texto
    bold: True

<Subtitulo@Texto>:
    font_size: sp(18) * app.escala_texto
    bold: True
    color: CINZA_CLARO

<Rotulo@Label>:
    color: TEXTO
    font_size: sp(16) * app.escala_texto
    text_size: self.size
    halign: 'left'
    valign: 'middle'

<Botao>:
    color: TEXTO
    bold: True
    font_size: sp(17) * app.escala_texto
    size_hint_y: None
    height: max(dp(50), self.texture_size[1] + dp(18))
    text_size: max(0, self.width - dp(16)), None
    halign: 'center'
    valign: 'middle'
    canvas.before:
        Color:
            rgba: [v * (0.75 if self.state == 'down' else 1.0) for v in self.cor[:3]] + [0.45 if self.disabled else 1.0]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<BotaoPrimario@Botao>:
    cor: AZUL
    color: 1, 1, 1, 1

<BotaoPerigo@Botao>:
    cor: VERMELHO_FORTE
    color: TEXTO

<BotaoOpcao>:
    cor: AZUL if self.ativo else CARTAO2
    color: (1, 1, 1, 1) if self.ativo else TEXTO

<Barra@Slider>:
    size_hint_y: None
    height: dp(44)
    padding: dp(14)
    background_width: 0
    cursor_size: 0, 0
    value_track: False
    canvas.after:
        Color:
            rgba: cor('#3A3A3E')
        RoundedRectangle:
            pos: self.x + self.padding, self.center_y - dp(3)
            size: max(0, self.width - 2 * self.padding), dp(6)
            radius: [dp(3)]
        Color:
            rgba: AZUL
        RoundedRectangle:
            pos: self.x + self.padding, self.center_y - dp(3)
            size: max(0, self.value_pos[0] - self.x - self.padding), dp(6)
            radius: [dp(3)]
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.value_pos[0] - dp(11), self.center_y - dp(11)
            size: dp(22), dp(22)
        Color:
            rgba: AZUL
        Ellipse:
            pos: self.value_pos[0] - dp(5), self.center_y - dp(5)
            size: dp(10), dp(10)

<Cartao@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: CARTAO
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: BORDA
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
            width: dp(1)

<CartaoAjuste@Cartao>:
    size_hint_x: None
    width: (self.parent.width - dp(12)) / 2 - 1 if (self.parent and self.parent.width > dp(700)) else (self.parent.width if self.parent else dp(300))

<Linha@BoxLayout>:
    size_hint_y: None
    height: max(dp(50), self.minimum_height)
    spacing: dp(10)

<Chip>:
    color: TEXTO
    bold: True
    font_size: sp(15) * app.escala_texto
    size_hint: None, None
    size: self.texture_size[0] + dp(26), self.texture_size[1] + dp(14)
    canvas.before:
        Color:
            rgba: self.fundo
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<CameraAnalise>:
    aspect_ratio: '16:9'
    letterbox_color: 0, 0, 0, 1
    canvas.before:
        PushMatrix
        Scale:
            x: -1 if self.espelhar else 1
            origin: self.center
    canvas.after:
        PopMatrix

ScreenManager:
    transition: NoTransition()
    TelaInicio:
        name: 'inicio'
    TelaCamera:
        name: 'camera'
    TelaCalibracao:
        name: 'calibracao'
    TelaAjustes:
        name: 'ajustes'
    TelaAjuda:
        name: 'ajuda'

<TelaInicio>:
    canvas.before:
        Color:
            rgba: FUNDO
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'horizontal' if root.width > root.height else 'vertical'
        padding: dp(32), dp(20)
        spacing: dp(32)
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(10)
            Widget:
            Texto:
                text: 'RéVisão'
                font_size: sp(46) * app.escala_texto
                bold: True
            Subtitulo:
                text: 'Câmera de ré inteligente para qualquer carro'
                font_size: sp(20) * app.escala_texto
            Texto:
                text: 'Instale a câmera na traseira do carro e ligue no aparelho pelo cabo USB ou por um receptor USB sem fio. O RéVisão reconhece pessoas, veículos e animais e avisa quando algo se aproxima.'
                color: TEXTO2
            Widget:
                size_hint_y: None
                height: dp(4)
            Cartao:
                Texto:
                    markup: True
                    text: '[b]Ferramenta de apoio.[/b] Não substitui os espelhos nem a sua atenção ao manobrar.'
            Widget:
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(12)
            size_hint_x: 0.42 if root.width > root.height else 1
            Widget:
            BotaoPrimario:
                text: 'Iniciar câmera'
                font_size: sp(21) * app.escala_texto
                height: max(dp(64), self.texture_size[1] + dp(22))
                on_release: app.iniciar_camera()
            Botao:
                text: 'Configurações'
                on_release: app.ir('ajustes')
            Widget:

<TelaCamera>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        FloatLayout:
            id: area
            CameraAnalise:
                id: camera
                pos_hint: {'x': 0, 'y': 0}
            Sobreposicao:
                id: sobre
                escala_texto: app.escala_texto
                pos_hint: {'x': 0, 'y': 0}
            Chip:
                text: app.nome_da_camera(app.camera_atual, app.cameras)
                pos_hint: {'x': 0.02, 'y': 0.03}
                font_size: sp(12) * app.escala_texto
            Chip:
                text: root.status_texto
                pos_hint: {'x': 0.02, 'top': 0.97}
                opacity: 0 if (root.analisando and root.nivel == 2) else 1
                fundo: [0.30, 0.33, 0.37, 0.92] if not root.analisando else ([0, 0, 0, 0.62] if root.nivel == 0 else (AMBAR if root.nivel == 1 else VERMELHO))
                color: ESCURO if (root.analisando and root.nivel > 0) else TEXTO
            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                width: min(area.width * 0.6, dp(480))
                height: self.minimum_height
                padding: dp(16), dp(8)
                spacing: dp(2)
                pos_hint: {'center_x': 0.5, 'top': 0.85}
                opacity: 1 if root.nivel == 2 else 0
                canvas.before:
                    Color:
                        rgba: VERMELHO_FORTE
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16)]
                Texto:
                    text: 'PARE'
                    bold: True
                    halign: 'center'
                    font_size: sp(48) * app.escala_texto
                Texto:
                    text: root.pare_detalhe
                    bold: True
                    halign: 'center'
                    font_size: sp(18) * app.escala_texto
                Texto:
                    text: 'bipe contínuo' if root.som_ligado else 'som desligado'
                    halign: 'center'
                    color: 1, 1, 1, 0.85
                    font_size: sp(14) * app.escala_texto
            Cartao:
                size_hint_x: None
                width: min(area.width * 0.8, dp(520))
                pos_hint: {'center_x': 0.5, 'center_y': 0.5} if root.aviso else {'x': 3, 'y': 3}
                opacity: 1 if root.aviso else 0
                Texto:
                    text: root.aviso
                    halign: 'center'
                Botao:
                    text: 'Voltar ao início'
                    on_release: root.parar()
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: None
            width: dp(112)
            padding: dp(10)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: FUNDO
                Rectangle:
                    pos: self.pos
                    size: self.size
            Botao:
                text: 'Som' if root.som_ligado else 'Mudo'
                size_hint_y: 1
                cor: CARTAO2 if root.som_ligado else [0.42, 0.45, 0.49, 1]
                on_release: root.alternar_som()
            Botao:
                text: 'Câmera'
                size_hint_y: 1
                on_release: root.trocar_camera()
            Botao:
                text: 'Ajustes'
                size_hint_y: 1
                on_release: root.abrir_ajustes()
            BotaoPerigo:
                text: 'Parar'
                size_hint_y: 1
                on_release: root.parar()

<TelaCalibracao>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        FloatLayout:
            id: area
            CameraAnalise:
                id: camera
                pos_hint: {'x': 0, 'y': 0}
            Sobreposicao:
                id: sobre
                modo_calibracao: True
                escala_texto: app.escala_texto
                linha_1m: root.linha_1m
                linha_3m: root.linha_3m
                on_linha_1m: root.linha_1m = self.linha_1m
                on_linha_3m: root.linha_3m = self.linha_3m
                pos_hint: {'x': 0, 'y': 0}
            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                width: min(area.width * 0.5, dp(400))
                height: self.minimum_height
                padding: dp(14)
                spacing: dp(6)
                pos_hint: {'x': 0.02, 'top': 0.97}
                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.09, 0.82
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(14)]
                Titulo:
                    text: 'Calibrar linhas-guia'
                    font_size: sp(20) * app.escala_texto
                Texto:
                    text: '1. Escolha a distância, peça para uma pessoa ficar de frente para a câmera nessa distância e toque em Medir pessoa.'
                    font_size: sp(14) * app.escala_texto
                Texto:
                    text: '2. Só se a câmera enxerga o chão: ligue Linhas do chão, marque 1 m e 3 m no chão e arraste as linhas até as marcas.'
                    font_size: sp(14) * app.escala_texto
                Texto:
                    text: '3. Toque em Salvar calibração.'
                    font_size: sp(14) * app.escala_texto
                Texto:
                    text: root.mensagem
                    color: CINZA_CLARO
                    font_size: sp(14) * app.escala_texto
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: None
            width: dp(150)
            padding: dp(10)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: FUNDO
                Rectangle:
                    pos: self.pos
                    size: self.size
            BotaoPrimario:
                text: 'Salvar calibração'
                size_hint_y: 1
                on_release: root.salvar()
            Botao:
                text: 'Distância: ' + '{:g}'.format(root.distancia_medida).replace('.', ',') + ' m'
                size_hint_y: 1
                on_release: root.mudar_distancia_medida()
            Botao:
                text: 'Medir pessoa'
                size_hint_y: 1
                on_release: root.medir_pessoa()
            BotaoOpcao:
                text: 'Linhas do chão: ' + ('sim' if root.usar_chao else 'não')
                ativo: root.usar_chao
                size_hint_y: 1
                on_release: root.alternar_chao()
            Botao:
                text: 'Padrão'
                size_hint_y: 1
                on_release: root.restaurar()
            Botao:
                text: 'Cancelar'
                size_hint_y: 1
                on_release: root.cancelar()

<TelaAjustes>:
    canvas.before:
        Color:
            rgba: FUNDO
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16), dp(12)
        spacing: dp(12)
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(12)
            Botao:
                text: 'Voltar'
                size_hint: None, 1
                width: dp(110)
                on_release: app.voltar()
            Rotulo:
                text: 'Configurações'
                bold: True
                font_size: sp(24) * app.escala_texto
            BotaoPrimario:
                text: 'Salvar e voltar'
                size_hint: None, 1
                width: dp(200)
                on_release: root.salvar_e_voltar()
        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)
            StackLayout:
                id: pilha
                orientation: 'lr-tb'
                spacing: dp(12)
                padding: 0, 0, 0, dp(16)
                size_hint_y: None
                height: self.minimum_height
                CartaoAjuste:
                    Subtitulo:
                        text: 'Alertas'
                    Linha:
                        Rotulo:
                            text: 'Som dos alertas'
                        BotaoOpcao:
                            text: 'Ligado' if root.som else 'Desligado'
                            ativo: root.som
                            size_hint_x: None
                            width: dp(150)
                            on_release: root.som = not root.som
                    Linha:
                        Rotulo:
                            text: 'Volume'
                        Rotulo:
                            text: '{}%'.format(int(round(root.volume * 100)))
                            bold: True
                            halign: 'right'
                            size_hint_x: None
                            width: dp(80)
                    Barra:
                        min: 0
                        max: 1
                        step: 0.05
                        value: root.volume
                        on_value: root.volume = self.value
                    Botao:
                        text: 'Testar som'
                        on_release: root.testar_som()
                CartaoAjuste:
                    Subtitulo:
                        text: 'Zonas de distância'
                    Linha:
                        Rotulo:
                            text: 'Perigo até'
                        Botao:
                            text: '−'
                            size_hint_x: None
                            width: dp(56)
                            on_release: root.mudar_perigo(-0.1)
                        Rotulo:
                            text: '{:.1f} m'.format(root.dist_perigo).replace('.', ',')
                            bold: True
                            halign: 'center'
                            size_hint_x: None
                            width: dp(84)
                        Botao:
                            text: '+'
                            size_hint_x: None
                            width: dp(56)
                            on_release: root.mudar_perigo(0.1)
                    Linha:
                        Rotulo:
                            text: 'Atenção até'
                        Botao:
                            text: '−'
                            size_hint_x: None
                            width: dp(56)
                            on_release: root.mudar_atencao(-0.5)
                        Rotulo:
                            text: '{:.1f} m'.format(root.dist_atencao).replace('.', ',')
                            bold: True
                            halign: 'center'
                            size_hint_x: None
                            width: dp(84)
                        Botao:
                            text: '+'
                            size_hint_x: None
                            width: dp(56)
                            on_release: root.mudar_atencao(0.5)
                    Subtitulo:
                        text: 'Sensibilidade'
                    Texto:
                        text: 'Confiança mínima da detecção: {}%'.format(int(round(root.confianca * 100)))
                        color: TEXTO2
                    Barra:
                        min: 0.3
                        max: 0.9
                        step: 0.05
                        value: root.confianca
                        on_value: root.confianca = self.value
                CartaoAjuste:
                    Subtitulo:
                        text: 'Câmera'
                    Texto:
                        text: 'Qual câmera usar'
                        color: TEXTO2
                    Spinner:
                        text: app.nome_da_camera(root.camera, app.cameras)
                        values: [nome for codigo, nome in app.cameras]
                        on_text: root.escolher_camera(self.text)
                        size_hint_y: None
                        height: dp(50)
                        font_size: sp(16) * app.escala_texto
                        background_normal: ''
                        background_color: AZUL
                        color: 1, 1, 1, 1
                        bold: True
                    Botao:
                        text: 'Procurando câmeras...' if app.procurando_cameras else 'Procurar câmeras de novo'
                        disabled: app.procurando_cameras
                        on_release: root.procurar_cameras()
                    Linha:
                        Rotulo:
                            text: 'Espelhar imagem'
                        BotaoOpcao:
                            text: 'Sim' if root.espelhar else 'Não'
                            ativo: root.espelhar
                            size_hint_x: None
                            width: dp(150)
                            on_release: root.espelhar = not root.espelhar
                    Botao:
                        text: 'Calibrar linhas-guia'
                        on_release: root.calibrar()
                    Texto:
                        text: 'Detector: ' + (app.motor_nome or ('não carregou' if app.erro_detector else 'carregando...'))
                        color: TEXTO2
                        font_size: sp(13) * app.escala_texto
                CartaoAjuste:
                    Subtitulo:
                        text: 'Acessibilidade'
                    Linha:
                        Rotulo:
                            text: 'Tamanho do texto'
                        Botao:
                            text: 'A−'
                            size_hint_x: None
                            width: dp(64)
                            on_release: root.mudar_texto(-0.1)
                        Rotulo:
                            text: '{}%'.format(int(round(root.escala_texto * 100)))
                            bold: True
                            halign: 'center'
                            size_hint_x: None
                            width: dp(76)
                        Botao:
                            text: 'A+'
                            size_hint_x: None
                            width: dp(64)
                            on_release: root.mudar_texto(0.1)
                    Botao:
                        text: 'Restaurar padrão'
                        on_release: root.restaurar()

<TelaAjuda>:
    canvas.before:
        Color:
            rgba: FUNDO
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20), dp(14)
        spacing: dp(10)
        Botao:
            text: 'Voltar'
            size_hint_x: None
            width: dp(110)
            on_release: app.voltar()
        BoxLayout:
            orientation: 'horizontal' if root.width > root.height else 'vertical'
            spacing: dp(24)
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                Titulo:
                    text: 'Câmera não encontrada'
                Texto:
                    text: 'O RéVisão não está recebendo o vídeo da câmera. Confira a ligação e tente de novo.'
                    color: TEXTO2
                Texto:
                    text: '1. Veja se o cabo USB ou o receptor sem fio está bem encaixado no aparelho.'
                Texto:
                    text: '2. Confira se a câmera na traseira do carro está ligada.'
                Texto:
                    text: '3. Toque em Tentar de novo.'
                Texto:
                    text: 'Em Configurações, confira se a opção Câmera USB está escolhida.'
                    color: TEXTO2
                    font_size: sp(14) * app.escala_texto
                Widget:
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(12)
                size_hint_x: 0.42 if root.width > root.height else 1
                Widget:
                BotaoPrimario:
                    text: 'Tentar de novo'
                    on_release: root.tentar_de_novo()
                Botao:
                    text: 'Abrir configurações'
                    on_release: app.ir('ajustes')
                Botao:
                    text: 'Voltar ao início'
                    on_release: app.voltar_para('inicio')
                Widget:
